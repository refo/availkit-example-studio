{
  "name": "availkit-example-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "receiver": "bun --env-file=.env.receiver server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests",
    "test:browser": "playwright test",
    "check": "bun run typecheck && bun run test && bun run build && bun run test:browser"
  },
  "dependencies": {
    "@availkit/client": "0.1.1",
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/newsreader": "5.2.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/bun": "1.3.14",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.0.4",
    "availkit": "0.1.1",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
